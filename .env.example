# --- IRIS connection (Atelier REST API) ---
# Base URL of the IRIS web server (management port). Matches the docker-compose mapping.
IRIS_MCP_BASE_URL=http://localhost:52773
# Path prefix of the Atelier API (rarely needs changing).
IRIS_MCP_API_PATH=/api/atelier
# Credentials. IRIS Community default is superuser / SYS.
IRIS_MCP_USERNAME=superuser
IRIS_MCP_PASSWORD=SYS
# Default namespace used when a tool call does not specify one.
IRIS_MCP_NAMESPACE=USER
# Optional comma-separated allowlist of namespaces the server may touch (empty = any).
IRIS_MCP_ALLOWED_NAMESPACES=
# Verify TLS certificates (set true when using https with a real cert).
IRIS_MCP_VERIFY_SSL=false
# HTTP request timeout (seconds).
IRIS_MCP_TIMEOUT=30

# --- Safety ---
# When true, edit/save/delete/compile tools are NOT registered (view-only server).
IRIS_MCP_READ_ONLY=false

# --- MCP server transport (Streamable HTTP) ---
IRIS_MCP_HOST=127.0.0.1
IRIS_MCP_PORT=8000
IRIS_MCP_MOUNT_PATH=/mcp
